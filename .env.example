# Platform Selection
# Options: macos-arm64, linux-x64, etc.
PLATFORM=macos-arm64

# Llama.cpp source/release version used when building the native adapter
LLAMA_VERSION=b8672

# Dotnet Runtime Identifier
DOTNET_RUNTIME=osx-arm64

# Dependencies Paths
MODEL_PATH=models/stories15M-q4_0.gguf

# Server Ports
GRPC_PORT=50051
LLAMA_REST_PORT=4999
BENCH_GRPCURL=http://localhost:5000

# API Keys
ApiKeys__Keys__0=dev-benchmark-key-secure
BENCH_APIKEY=dev-benchmark-key-secure
